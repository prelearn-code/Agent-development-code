# ============================================================
# 环境变量模板 —— 复制为 .env 后填写。.env 不进 git。
# 本文件不得包含任何真实密钥。
# 键名必须与 packages/core/config.py 的 Settings 字段一致，
# 由 scripts/selftest.py 自动校验对齐。
# ============================================================

# ---- 应用 ----
APP_ENV=dev
APP_LOG_LEVEL=INFO
API_KEY_HEADER=X-API-Key

# ---- LLM / Ollama ----
# 决策：Ollama 是 Ubuntu 内的 systemd 服务，与本应用同机。
#   应用通过回环地址访问，不经过任何跨系统网络，也不需要宿主 IP。
#   确认服务：systemctl status ollama --no-pager
#   确认监听：ss -ltnp | grep 11434      # 应为 127.0.0.1:11434
#   不要改成 0.0.0.0 或宿主 IP：容器需要时用 network_mode: host（见指南 §5.1）。
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Controller 计划模型：qwen3.5:4b（family qwen35，Q4_K_M，256K 上下文，
# 原生 tools/thinking/多模态）。要求 Ollama >= 0.30.0。
# 出厂采样参数 temperature=1/top_p=0.95/top_k=20/presence_penalty=1.5，
# 与下面的实验配置分开记录。
CONTROLLER_MODEL=qwen3.5:4b
CONTROLLER_MODEL_SMALL=qwen3.5:4b
CONTROLLER_MODEL_LARGE=
JUDGE_MODEL=
LLM_TIMEOUT_S=120
LLM_THINK=false
LLM_NUM_CTX=8192

# ---- 数据库（M2 引入；M1 之前保持为空）----
# 角色隔离：app/query/audit 各自独立凭据，服务不持有 bootstrap 超级用户。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lpa
DATABASE_URL=
AUDIT_DATABASE_URL=

# ---- 向量库（M3 引入）----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---- 路径与安全 ----
# Ubuntu 内的路径，多个用逗号分隔
ALLOWED_READ_ROOTS=./data/documents,./data/datasets
SANDBOX_IMAGE=
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=2048
SANDBOX_PIDS_LIMIT=128
SANDBOX_NETWORK=none

# ---- MCP（M4 引入）----
MCP_TRANSPORT=stdio
MCP_LOG_DIR=./data/mcp-logs
MCP_FS_ROOT=./data

# ---- 本地密码工具 ----
# 相对路径以本代码仓库根目录为基准；也可填写绝对路径。
CRYPTO_KEY_ROOT=keys
CRYPTO_DATA_ROOT=data
GMSSL_BIN=../.local/gmssl/bin/gmssl
OPENSSL_BIN=/bin/openssl
CRYPTO_MAX_FILE_BYTES=104857600
CRYPTO_TIMEOUT_S=10

# ---- 评测 ----
EVAL_CONCURRENCY=1
EVAL_DATASET=eval/datasets/eval-v1.jsonl
