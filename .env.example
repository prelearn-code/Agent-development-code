# ============================================================
# 环境变量模板 —— 复制为 .env 后填写。.env 不进 git。
# 本文件不得包含任何真实密钥。
# 键名必须与 packages/core/config.py 的 Settings 字段一致，
# 由 scripts/selftest.py 自动校验对齐。
# ============================================================

# ---- 应用 ----
APP_ENV=dev
APP_LOG_LEVEL=INFO
API_KEY_HEADER=X-API-Key

# ---- LLM / Ollama ----
# 决策：Ollama 运行在 Windows 原生（GPU 已生效）。
#   WSL 内访问 Windows 宿主：宿主机 IP，不是 localhost（WSL 默认 NAT 模式，
#   WSL->Windows 的 localhost 转发不可用）。
#   Windows 侧需设 OLLAMA_HOST=0.0.0.0:11434 并放行防火墙。
#   用下一条命令取得宿主机 IP：
#     ip route show default | awk '{print $3}'
OLLAMA_BASE_URL=http://172.26.0.1:11434
CONTROLLER_MODEL=qwen3:4b
CONTROLLER_MODEL_SMALL=qwen3:4b
CONTROLLER_MODEL_LARGE=
JUDGE_MODEL=
LLM_TIMEOUT_S=120
LLM_THINK=false
LLM_NUM_CTX=8192

# ---- 数据库（M2 引入；M1 之前保持为空）----
# 角色隔离：app/query/audit 各自独立凭据，服务不持有 bootstrap 超级用户。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lpa
DATABASE_URL=
AUDIT_DATABASE_URL=

# ---- 向量库（M3 引入）----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---- 路径与安全 ----
# WSL 路径，多个用逗号分隔
ALLOWED_READ_ROOTS=./data/documents,./data/datasets
SANDBOX_IMAGE=
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=2048
SANDBOX_PIDS_LIMIT=128
SANDBOX_NETWORK=none

# ---- MCP（M4 引入）----
MCP_TRANSPORT=stdio
MCP_LOG_DIR=./data/mcp-logs
MCP_FS_ROOT=./data

# ---- 评测 ----
EVAL_CONCURRENCY=1
EVAL_DATASET=eval/datasets/eval-v1.jsonl
